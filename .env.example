# Supabase project settings (Project Settings > API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API key, used to auto-generate "why wrong answers are wrong"
# and memory aids from your rationale text. Free tier — no cost for this
# app's usage level.
# Get one at https://aistudio.google.com/apikey
# Leave blank if you want to skip auto-generation and fill those fields manually.
GEMINI_API_KEY=
